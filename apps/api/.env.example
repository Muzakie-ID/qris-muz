# Salin ke .env lalu isi.

PORT=3001
DATABASE_URL=postgres://qris:qris@localhost:5432/qrismuz

# Kunci enkripsi secret di database. Buat dengan: openssl rand -base64 32
# JANGAN diganti setelah ada data: secret device dan webhook tidak bisa dibuka lagi.
APP_ENCRYPTION_KEY=

# Alamat publik API ini dan web app (untuk qr_image_url dan checkout_url).
PUBLIC_API_URL=http://localhost:3001
CHECKOUT_BASE_URL=http://localhost:3000

# Token admin sementara (minimal 24 karakter) sampai login owner dibuat di Tahap 3.
# Buat dengan: openssl rand -base64 32
ADMIN_TOKEN=

# Batas nominal per transaksi (rupiah) dan masa tenggang kode unik (jam).
QRIS_MAX_AMOUNT=10000000
UNIQUE_CODE_GRACE_HOURS=24

# Device dan listener.
DEVICE_CLOCK_TOLERANCE_SEC=300
LISTENER_OFFLINE_AFTER_SEC=300

# Alat uji QRIS Tahap 1 (/v1/qris/*). Matikan di produksi.
QRIS_TOOLS_ENABLED=false
QRIS_STATIC_PAYLOAD=
