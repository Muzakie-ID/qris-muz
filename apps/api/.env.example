# Salin ke .env lalu isi.

PORT=3001

# QRIS statis milik merchant: hasil scan QR, teks panjang yang diawali 000201.
QRIS_STATIC_PAYLOAD=

# Batas nominal per transaksi (rupiah).
QRIS_MAX_AMOUNT=10000000

# Alat uji QRIS (/v1/qris/*). Nyalakan hanya di lokal untuk uji scan Tahap 1.
QRIS_TOOLS_ENABLED=true
