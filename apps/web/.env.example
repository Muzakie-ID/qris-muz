# Salin ke .env.local lalu isi.

# Alamat backend (apps/api) dari server Next.js.
API_URL=http://localhost:3001
# Alamat backend yang dibuka browser pembeli (status realtime di halaman bayar).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sama dengan ADMIN_TOKEN di apps/api. Hanya dipakai di server, tidak dikirim ke browser.
ADMIN_TOKEN=

# Login dashboard sementara (sampai login owner + 2FA di Tahap 3).
DASHBOARD_PASSWORD=
# Kunci tanda tangan cookie sesi, minimal 24 karakter: openssl rand -base64 32
SESSION_SECRET=
