# Salin ke .env.local lalu isi.

# Alamat backend (apps/api) dari server Next.js. Di Docker Compose: http://api:3001
API_URL=http://localhost:3001
# Alamat publik backend yang dibuka browser pembeli (status realtime di halaman bayar).
PUBLIC_API_URL=http://localhost:3001

# Login dashboard memakai akun owner di backend (email + password + 2FA).
# Buat akun pertama di server API: node dist/scripts/owner-cli.js create email@anda.id
