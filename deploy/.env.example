# Salin ke deploy/.env lalu isi. Jangan commit file .env.

# Domain (arahkan record A keduanya ke IP VPS sebelum menjalankan).
API_DOMAIN=api.contoh.id
WEB_DOMAIN=bayar.contoh.id
# Email untuk Let's Encrypt (pemberitahuan sertifikat).
ACME_EMAIL=anda@contoh.id

# Password database. Pakai huruf/angka saja agar aman di URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# Kunci enkripsi secret di database (32 byte): openssl rand -base64 32
# SIMPAN di tempat aman terpisah dari VPS. Tanpa kunci ini, backup tidak bisa membuka secret webhook/device.
APP_ENCRYPTION_KEY=
# Opsional: token untuk skrip otomasi ke endpoint admin dari dalam VPS. Kosong = mati.
ADMIN_TOKEN=

# Backup ke Google Drive lewat rclone, mis. gdrive:qrismuz-backup (lihat deploy/README.md).
RCLONE_REMOTE=
# Jadwal (zona Asia/Jakarta): backup harian 02.30, uji restore Minggu 04.15.
BACKUP_CRON=30 2 * * *
RESTORE_TEST_CRON=15 4 * * 0
REMOTE_KEEP_DAYS=30
LOCAL_KEEP_DAYS=7

# Opsional
# RATE_LIMIT_PER_MIN=120
# LISTENER_OFFLINE_AFTER_SEC=300
# BACKUP_MAX_AGE_HOURS=26
